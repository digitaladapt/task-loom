# TaskLoom .env.example — every variable documented inline.
#
# Copy to .env (uncommitted) and fill in the values for your environment:
#   cp .env.example .env
#
# Real environment variables always win over .env files, and production
# containers get these same variables injected directly (see compose.yaml).
# DO NOT DEFINE PRODUCTION SECRETS IN ANY COMMITTED FILE.

### symfony/framework-bundle ###
# dev|test|prod. Production containers run APP_ENV=prod (set in the Dockerfile).
APP_ENV=dev
# Symmetric signing secret (cookies, CSRF). Generate: openssl rand -hex 32
APP_SECRET=
# Shared scratch directory (runtime).
APP_SHARE_DIR=var/share

### TaskLoom — admin auth (v1: single admin user) ###
# The initial admin password. Generate: openssl rand -base64 24
# (The admin username is fixed: "admin".)
TASKLOOM_ADMIN_PASSWORD=

### TaskLoom — LLM (OpenAI-compatible endpoint) ###
# Base URL of the endpoint. Local-first: typically Ollama, vLLM, or llama.cpp.
TASKLOOM_LLM_BASE_URL=http://localhost:11434
# Model name as the endpoint knows it.
TASKLOOM_LLM_MODEL=qwen3:14b
# API key if the endpoint requires one (Ollama does not). Optional.
TASKLOOM_LLM_API_KEY=
# Max concurrent LLM requests (task-loop's llm_max_concurrency). On a single
# local GPU, 1 is the honest setting: requests serialize.
# In the async engine this knob is the number of `messenger:consume llm`
# workers to run — each worker holds at most one request on the wire, so N
# workers = N concurrent LLM requests (see README, "Concurrency").
TASKLOOM_LLM_MAX_CONCURRENCY=1
# Timeout for one LLM request, in seconds.
TASKLOOM_LLM_TIMEOUT=300

### TaskLoom — run engine budgets ###
# Max tool-call exchanges per run before "incomplete" (fail closed).
TASKLOOM_STEP_BUDGET=50
# Per-tool-call retries with error feedback, before the circuit breaker.
TASKLOOM_TOOL_RETRIES=2
# Circuit breaker: same tool, same error class, N times → needs_attention.
TASKLOOM_CIRCUIT_BREAKER=3
# Context window of the model (tokens) — used for the fail-closed budget.
TASKLOOM_CONTEXT_LIMIT=32768
# Max percentage of the context limit a single tool result may occupy.
TASKLOOM_MAX_TOOL_OUTPUT_PCT=15
# Tool-call exchanges kept after the prompt head (older assistant turns are
# pruned; the initial user section — the task prompt — is NEVER pruned).
TASKLOOM_WINDOW_TAIL_EXCHANGES=10

### TaskLoom — MCP servers (tool catalog) ###
# Comma-separated list of server names registered in the admin UI; MCP server
# credentials are env vars named by each McpServer.cred_var, resolved at call
# time and scrubbed from all logged traces.
TASKLOOM_MCP_SERVERS=weather,calendar,transactions

### TaskLoom — utilities ###
# Database file for bin/backup-db.sh (WAL-aware snapshot). Default: the
# DATABASE_URL SQLite path under data/.
# TASKLOOM_DB=data/taskloom.db

### symfony/routing ###
# Base URI used to generate absolute URLs in non-HTTP contexts (CLI commands,
# messenger workers). Must match the public-facing URL of the deployment.
DEFAULT_URI=http://localhost

### symfony/framework-bundle (Doctrine) ###
# SQLite (single file, WAL). %kernel.project_dir% resolves at runtime.
DATABASE_URL=sqlite:///%kernel.project_dir%/data/taskloom.db

### symfony/messenger ###
# Doctrine-backed transport (SQLite, same file as the app). The llm and tools
# lanes share this table, selected by queue_name; failed messages land in a
# third lane. auto_setup=0: the messenger_messages table is created by an
# explicit migration, never at boot (§8.6) — run
#   php bin/console doctrine:migrations:migrate
# before starting workers.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0