# TaskLoom .env.example — every variable documented inline.
#
# Copy to .env (uncommitted) and fill in the values for your environment:
#   cp .env.example .env
#
# Real environment variables always win over .env files, and production
# containers get these same variables injected directly (see compose.yaml).
# DO NOT DEFINE PRODUCTION SECRETS IN ANY COMMITTED FILE.

### symfony/framework-bundle ###
# dev|test|prod. Production containers run APP_ENV=prod (set in the Dockerfile).
APP_ENV=dev
# Symmetric signing secret (cookies, CSRF). Generate: openssl rand -hex 32
# REQUIRED in every environment: the container entrypoint verifies its
# presence (and every other variable on this list) before it starts anything.
APP_SECRET=
# Shared scratch directory (runtime).
APP_SHARE_DIR=var/share

### TaskLoom — admin auth (v1: single admin user) ###
# The admin password, used by the browser sign-in form only. Generate:
# openssl rand -base64 24
# (The admin username is fixed: "admin". The browser may keep this password
# in localStorage — "stay signed in on this device" — so use a value unique
# to this deployment.)
TASKLOOM_ADMIN_PASSWORD=
# The MCP endpoint's bearer key (Authorization: Bearer <key>). This is the
# credential external agents use against POST /mcp — deliberately NOT the
# admin password, so an agent key can be rotated without touching the human
# login. Required for the MCP endpoint to accept requests; when unset every
# MCP request is refused (fail closed). Generate: openssl rand -base64 32
TASKLOOM_MCP_API_KEY=

### TaskLoom — LLM (OpenAI-compatible endpoint) ###
# Base URL of the endpoint. Local-first: typically Ollama, vLLM, or llama.cpp.
TASKLOOM_LLM_BASE_URL=http://localhost:11434
# Model name as the endpoint knows it.
TASKLOOM_LLM_MODEL=qwen3:14b
# API key if the endpoint requires one (Ollama does not). Optional.
TASKLOOM_LLM_API_KEY=
# Max concurrent LLM requests (task-loop's llm_max_concurrency). On a single
# local GPU, 1 is the honest setting: requests serialize.
# The engine is turn-based — one LLM request per queued message — so this is
# literally the number of `messenger:consume llm` workers the container
# entrypoint starts; each worker holds at most one request on the wire, and N
# workers = N concurrent LLM requests (see README, "Concurrency").
TASKLOOM_LLM_MAX_CONCURRENCY=1
# Timeout for one LLM request, in seconds.
TASKLOOM_LLM_TIMEOUT=300

### TaskLoom — worker fleet (container runtime) ###
# These knobs shape the worker fleet the entrypoint's `serve` mode supervises.

# Tool-turn workers. A tool turn executes the tool calls the model requested;
# it mostly waits on external servers (I/O), so a few run concurrently without
# competing for the model — a slow tool never blocks the llm lane.
TASKLOOM_TOOL_MAX_CONCURRENCY=2
# Workers recycle after this many seconds (and after the memory limit below),
# so a long-lived PHP process cannot leak its way into a restart loop under
# OOM. The entrypoint restarts a recycled worker immediately.
TASKLOOM_WORKER_TIME_LIMIT=3600
# Per-worker memory ceiling; a worker that exceeds it exits cleanly and is
# restarted by the entrypoint.
TASKLOOM_WORKER_MEMORY_LIMIT=256M
# How long a graceful shutdown may take before workers are killed (seconds).
# Keep compose's stop_grace_period above this value.
TASKLOOM_SHUTDOWN_TIMEOUT=30
# Run migrations at container boot. Leave 0 and let the compose `migrate`
# service (or a manual command) own schema changes — a container that
# migrates at boot cannot be scaled past one replica (§8.6). Set to 1 only for
# a single-replica deployment that prefers boot-time migration.
TASKLOOM_MIGRATE_ON_BOOT=0
# Sync the tool catalog when the app container starts (non-fatal: a down
# server never blocks boot and never wipes known tools — SPEC §7).
# Worker/one-shot containers should set this to 0; the entrypoint does that
# for the compose `migrate` service.
TASKLOOM_SYNC_ON_BOOT=1

### TaskLoom — run engine budgets ###
# Max tool-call exchanges per run before "incomplete" (fail closed).
TASKLOOM_STEP_BUDGET=50
# Per-tool-call retries with error feedback, before the circuit breaker.
TASKLOOM_TOOL_RETRIES=2
# Circuit breaker: same tool, same error class, N times → needs_attention.
TASKLOOM_CIRCUIT_BREAKER=3
# Context window of the model (tokens) — used for the fail-closed budget.
TASKLOOM_CONTEXT_LIMIT=32768
# Max percentage of the context limit a single tool result may occupy.
TASKLOOM_MAX_TOOL_OUTPUT_PCT=15
# Tool-call exchanges kept after the prompt head (older assistant turns are
# pruned; the initial user section — the task prompt — is NEVER pruned).
TASKLOOM_WINDOW_TAIL_EXCHANGES=10

### TaskLoom — MCP servers (tool catalog) ###
# MCP server credentials are env vars NAMED by each McpServer.cred_var (set in
# the admin UI), resolved at call time and scrubbed from all logged traces.
# Name the variables here (values only, never secrets in a committed file):
#   WEATHER_API_KEY=...
#   CALENDAR_TOKEN=...
#
# A server's cred_var (set with
#   app:catalog:server add <name> --url=… --cred-var=<ENV_VAR_NAME>
# or in the admin UI) is resolved to an Authorization header at sync AND call
# time. A bare token is sent as "Bearer <token>"; a value that already spells
# its scheme ("Bearer …", "Basic …") is sent verbatim. If the named variable is
# unset or empty, the sync/call fails with a message naming the VARIABLE —
# never the value — rather than silently sending an unauthenticated request.

### TaskLoom — utilities ###
# Database file for bin/backup-db.sh (WAL-aware snapshot). Default: the
# DATABASE_URL SQLite path under data/.
# TASKLOOM_DB=data/taskloom.db

### TaskLoom — scheduler (SPEC §14) ###
# The wall-clock timezone cron schedules are evaluated in (IANA name).
# Required: a schedule means "this time where the operator lives".
# The grounding block speaks this same clock: a Chicago deployment's runs
# read "09:15 (America/Chicago)", never the container's UTC.
TASKLOOM_TIMEZONE=UTC
# Run the scheduler daemon in the container fleet. Set to 0 to leave it out
# (scheduled tasks then only fire via an external `app:schedule:tick` cron,
# or not at all).
TASKLOOM_SCHEDULER_ENABLED=1
# Seconds between scheduler ticks (default 60 — cron granularity is a minute;
# a tick that arrives late still catches the slot up).
TASKLOOM_SCHEDULE_INTERVAL=60

### TaskLoom — grounding & prompt (SPEC §4.1, §4.2) ###
# Units the grounding block announces to the model. The model reads this
# once, at the head of the run, and reports in those units throughout:
# metric or imperial. Unset means metric.
TASKLOOM_UNITS=metric
#
# The run prompt's configurable parts. Unset means the built-in text, which
# is exactly what earlier versions sent — configuring nothing changes
# nothing. Each knob takes EITHER an inline value OR a file path; setting
# both is refused (two sources for one value is ambiguous).
#
# The preamble opens every run. The built-in text states the untrusted-
# content posture (tool results are data, not instructions) — a replacement
# takes over that sentence, so keep it if you rewrite this.
# In .env, prefer single quotes: they do no dollar-interpolation. For prose
# with apostrophes or multiple lines, use the _FILE form instead (a path
# inside the container — mount it) — far easier than env quoting rules.
# TASKLOOM_SYSTEM_PROMPT='You are an autonomous task executor.'
# TASKLOOM_SYSTEM_PROMPT_FILE=/etc/taskloom/preamble.txt
#
# The completion text sits under the harness-owned "## Completion" header.
# The engine enforces completion structurally either way — a terminal
# message with no content is not a completion, and the step budget still
# fails closed — but the ask (finish with the deliverable itself, not a
# bare "done") lives in this text, so keep it if you rewrite it.
# TASKLOOM_COMPLETION_PROMPT='Finish with the deliverable itself.'
# TASKLOOM_COMPLETION_PROMPT_FILE=/etc/taskloom/completion.txt
#
# Render the prompt's human-readable toolbox list. The tool DEFINITIONS are
# always sent on every request regardless — this only controls the prose
# list of the same names. Set to 0 to save tokens on large toolboxes (and
# mind the built-in preamble's "the tools listed below" phrasing, or
# replace the preamble too).
TASKLOOM_PROMPT_TOOLBOX_LIST=1

### symfony/routing ###
# Base URI used to generate absolute URLs in non-HTTP contexts (CLI commands,
# messenger workers). Must match the public-facing URL of the deployment.
DEFAULT_URI=http://localhost

### symfony/framework-bundle (Doctrine) ###
# SQLite (single file, WAL). %kernel.project_dir% resolves at runtime.
DATABASE_URL=sqlite:///%kernel.project_dir%/data/taskloom.db

### symfony/messenger ###
# Doctrine-backed transport (SQLite, same file as the app). The llm and tools
# lanes share this table, selected by queue_name; failed messages land in a
# third lane. auto_setup=0: the messenger_messages table is created by an
# explicit migration, never at boot (§8.6) — run
#   php bin/console doctrine:migrations:migrate
# before starting workers.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0