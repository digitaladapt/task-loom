# .dockerignore — project-local file, NOT vendored from guiding-light (§8.2(2):
# no canonical leaf exists; conformance checks cover it instead).
# config/ and docker/ are never dockerignored (§6.3) — the Dockerfile COPYs
# docker/php.ini, docker/Caddyfile and docker/entrypoint.sh into the image.
# vendor/, tests/, var/ are.

/.env
/.env.*
/config/secrets/
/public/bundles/
/tests/
/var/
/vendor/
/node_modules/
/.git/
/.github/
/.gitea/
/.ci/
/docs/
/compose.override.yaml
/phpunit.cache/
/.phpunit.cache/
/.php-cs-fixer.cache
/*.md
!/README.md
/.php-cs-fixer.php
/.php-cs-fixer.dist.php
/phpstan*
/importmap.php