<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        {# Never disable pinch-zoom (WCAG 1.4.4); viewport-fit=cover for safe areas. #}
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <meta name="theme-color" content="#1a1a2e">
        <meta name="description" content="{% block meta_description %}TaskLoom — local-first agentic harness{% endblock %}">
        <title>{% block title %}TaskLoom{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🧵</text></svg>">
        <link rel="manifest" href="{{ asset('manifest.webmanifest') }}">
        {% block stylesheets %}
            {#
                CSS is linked, never imported from JavaScript: an import would
                surface as a `data:application/javascript,…` importmap entry,
                which the browser loads as a script and our CSP blocks.
            #}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}
        {#
            The importmap and its entrypoint imports are inline scripts, so
            they carry the request's CSP nonce — the policy is script-src
            'self' with no 'unsafe-inline' (App\Observability\CspNonce explains
            the bug that made this necessary).

            One importmap() call per page, ever: a document may contain only
            one <script type="importmap">. Pages needing an extra entrypoint
            override this block and list them all.
        #}
        {% block javascripts %}
            {{ importmap(entrypoints|default('app'), {nonce: csp_nonce()}) }}
        {% endblock %}
    </head>
    <body>
        {% if app.user %}
            {#
                The menu bar (SPEC §8): every signed-in page gets the same
                top-level navigation. Before this, each template grew its own
                <nav> with whatever links that page happened to need — the
                tool catalog was reachable from exactly one page, the
                attention queue from two — so the answer to "where can I go
                from here" depended on where you already were. One bar, one
                list, on every page, with the current section marked
                (`aria-current`).

                Rendered only when a session exists: the login page stays
                deliberately bare (a visitor there has no session, and
                nothing here should be visible before credentials), and
                every route the items point at requires ROLE_ADMIN anyway.

                `aria-current="page"` marks the item whose own target is the
                current route; on a sub-page the containing section is
                marked `"true"` instead (/tasks/47 is *in* Tasks, but the
                Tasks item's target, /, is not that page).
            #}
            {% set menu_sections = {
                'app_task_list': 'tasks',
                'app_task_detail': 'tasks',
                'app_task_edit': 'tasks',
                'app_task_update': 'tasks',
                'app_task_new': 'new',
                'app_task_create': 'new',
                'app_run_list': 'runs',
                'app_run_detail': 'runs',
                'app_attention': 'attention',
                'app_tool_list': 'tools',
                'app_chat_list': 'chat',
                'app_chat_show': 'chat',
                'app_chat_say': 'chat',
                'app_chat_new': 'chat',
            } %}
            {% set menu_items = [
                {section: 'tasks', route: 'app_task_list', label: 'Tasks'},
                {section: 'runs', route: 'app_run_list', label: 'Runs'},
                {section: 'attention', route: 'app_attention', label: 'Attention'},
                {section: 'tools', route: 'app_tool_list', label: 'Tool catalog'},
                {section: 'chat', route: 'app_chat_list', label: 'Chat'},
                {section: 'new', route: 'app_task_new', label: 'New task'},
            ] %}
            {% set current_route = app.current_route %}
            {% set current_section = menu_sections[current_route] ?? '' %}

            <header class="site-header" data-site-menu>
                <div class="site-header-inner">
                    <a class="site-brand" href="{{ path('app_task_list') }}">TaskLoom</a>

                    {#
                        The small-screen disclosure control. Always rendered,
                        but hidden by CSS until the script claims the header
                        (`data-menu-collapsible`): a browser without
                        JavaScript keeps the panel as a plain, fully usable
                        list and never sees a button that does nothing.
                    #}
                    <button type="button" class="menu-toggle" data-menu-toggle
                            aria-expanded="false" aria-controls="site-menu">Menu</button>

                    <div class="site-menu-panel" id="site-menu" data-menu-panel>
                        <nav class="site-menu" aria-label="Main">
                            <ul class="site-menu-list">
                                {% for item in menu_items %}
                                    <li><a href="{{ path(item.route) }}"{% if item.section == current_section %} aria-current="{{ current_route == item.route ? 'page' : 'true' }}"{% endif %}>{{ item.label }}</a></li>
                                {% endfor %}
                            </ul>
                        </nav>

                        {#
                            The sign-out control. `logout_path()` asks the
                            security bundle for the configured path, so it
                            cannot drift from security.yaml; the CSRF token is
                            the one the logout listener validates.
                        #}
                        <div class="site-session">
                            <span class="muted">signed in as {{ app.user.userIdentifier }}</span>
                            <form method="post" action="{{ logout_path() }}" data-signout>
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                                <button type="submit" class="small">Sign out</button>
                            </form>
                        </div>
                    </div>
                </div>
            </header>
        {% endif %}

        {#
            The page column: one wrapper, so pages stop each having to add
            their own.

            Before this, the column lived on every individual component —
            `.page-header`, `section`, `.cards`, `.record`, `.flash`,
            `.page-back` each carried the same `max-width: 40rem; margin: 0
            auto`. That works only for as long as every element remembers, and
            the chat pages did not: a form and a status paragraph that sat
            outside any `section` rendered full-viewport width, and a rule like
            `.chat-transcript { margin: 1rem 0 }` silently *overrode* the
            `section { margin: 0 auto }` that was holding the column, because a
            class beats a type selector. A page whose layout depends on every
            element opting in is a page that will drift.

            `main` rather than a `div`: it is the landmark a screen reader uses
            to skip to the content, and these pages had none — which is why
            `auth/login.html.twig` had to invent its own `<main>` (it keeps it:
            the sign-in shell centres a card in the viewport, which is a
            different job from this column).

            Padding here rather than on the children means the 40rem is the
            *content* width, and the gutter is part of the column, so nothing
            inside has to know about the edge.
        #}
        <main class="page">
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
