<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        {# Never disable pinch-zoom (WCAG 1.4.4); viewport-fit=cover for safe areas. #}
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <meta name="theme-color" content="#1a1a2e">
        <meta name="description" content="{% block meta_description %}TaskLoom — local-first agentic harness{% endblock %}">
        <title>{% block title %}TaskLoom{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🧵</text></svg>">
        <link rel="manifest" href="{{ asset('manifest.webmanifest') }}">
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}
        {% block javascripts %}
            <script src="{{ asset('app.js') }}" defer></script>
        {% endblock %}
    </head>
    <body>
        {% block body %}{% endblock %}
    </body>
</html>