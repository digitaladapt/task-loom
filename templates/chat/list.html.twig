{% extends 'base.html.twig' %}

{% import '_toolbox.html.twig' as toolbox_ui %}

{% block title %}Chat — TaskLoom{% endblock %}

{% block body %}
<header class="page-header">
    <h1>Chat</h1>
</header>

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <p class="flash flash-{{ label }}" role="status">{{ message }}</p>
    {% endfor %}
{% endfor %}

{#
    Starting a conversation is one field — plus what she may use in it.

    The title is derived from the first message rather than asked for
    separately: naming a conversation before you can speak in it is friction
    for no gain, and the first thing you say is usually the better name anyway.

    The toolbox here applies to the *first* exchange only. Starting a
    conversation with no tools and enabling them once you have talked the
    problem through is the intended shape: ask first, act second.

    (From the second message onward the picker follows the *previous*
    exchange's choice, so turning a tool off stays off until you turn it back
    on.)
#}
<section aria-labelledby="new-chat-heading">
    <h2 id="new-chat-heading">Start a conversation</h2>
    <form method="post" action="{{ path('app_chat_new') }}" class="chat-compose">
        <input type="hidden" name="_token" value="{{ csrf_token('chat-new') }}">

        {#
            The initial mode is `tags`, matching the widget's own default — this
            said `explicit`, which opened a new conversation on the tool-name
            panel while every other picker in the app opened on tags. The mode
            is not cosmetic: it is the panel whose free-text companion and
            checkboxes the human sees first, and getting it backwards invites
            choosing by tool name when the catalog's tags were the point.
        #}
        {{ toolbox_ui.toolbox(
            '',
            {toolbox_mode: 'tags', toolbox: []},
            known_tags,
            catalog_tools,
            errors|default({}),
            'chat_toolbox'
        ) }}

        <label for="new-message" class="visually-hidden">First message</label>
        <textarea id="new-message" name="message" rows="3" required
                  placeholder="Say something…" autocomplete="off"></textarea>
        <button type="submit">Send</button>
    </form>
</section>

<section aria-labelledby="chats-heading">
    <h2 id="chats-heading">Conversations</h2>

    {% if chats is empty %}
        <p class="muted">Nothing said yet.</p>
    {% else %}
        <ul class="cards">
        {% for chat in chats %}
            <li class="card">
                <div class="card-title"><a href="{{ path('app_chat_show', {id: chat.id}) }}">{{ chat.title }}</a></div>
                <p class="muted">
                    {{ chat.exchanges|length }} exchange{{ chat.exchanges|length == 1 ? '' : 's' }}
                    · last activity {{ chat.updatedAt|date('Y-m-d H:i') }}
                </p>
            </li>
        {% endfor %}
        </ul>
    {% endif %}
</section>
{% endblock %}
