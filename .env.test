# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

###> symfony/routing ###
# Required by config/packages/routing.yaml (default_uri) so the app can boot
# in CI, where only .env.test exists. Inert for tests: it only affects URL
# generation in non-HTTP contexts (CLI, messenger workers).
DEFAULT_URI=http://localhost
###< symfony/routing ###

### TaskLoom — SQLite for tests (separate file, WAL-safe) ###
DATABASE_URL="sqlite:///%kernel.project_dir%/var/taskloom_test.db"
### TaskLoom — run-engine test budgets (documented defaults) ###
TASKLOOM_LLM_BASE_URL=http://127.0.0.1:1
TASKLOOM_LLM_MODEL=test-model
TASKLOOM_LLM_API_KEY=
TASKLOOM_LLM_TIMEOUT=10
TASKLOOM_STEP_BUDGET=50
TASKLOOM_TOOL_RETRIES=2
TASKLOOM_CIRCUIT_BREAKER=3
TASKLOOM_CONTEXT_LIMIT=32768
TASKLOOM_MAX_TOOL_OUTPUT_PCT=15
TASKLOOM_WINDOW_TAIL_EXCHANGES=10
